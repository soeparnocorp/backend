{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-03",
	"migrations": [
		{
			"new_sqlite_classes": [
                "AuthorizationDurableObject",
				"ConversationDurableObject"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
            {
				"class_name": "AuthorizationDurableObject",
				"name": "AUTHORIZATION_DURABLE_OBJECT"
			},
			{
				"class_name": "ConversationDurableObject",
				"name": "CONVERSATION_DURABLE_OBJECT"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "MESSAGE_ASSETS",
			"bucket_name": "message-assets"
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"R2_ACCOUNT_ID": "53d61c09062b1ca11788fa763f79313a",
		"R2_BUCKET_NAME": "message-assets",
		"R2_ENDPOINT": "https://53d61c09062b1ca11788fa763f79313a.r2.cloudflarestorage.com"
	}
}
